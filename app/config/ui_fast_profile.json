{
  "comment": "Baked UI fast profile — Pass1 SAM-ID + SOLIDER re-entry; Pass2 SOLIDER long-gap link",
  "pipeline": {
    "use_reid": false,
    "use_sam_identity": true,
    "sam_identity_backend": "memory",
    "sam_osnet_reentry": true,
    "sam_osnet_reentry_thresh": 0.65,
    "sam_osnet_reentry_min_miss": 15,
    "identity_gallery_enabled": true,
    "identity_gallery_min_sim": 0.65,
    "identity_gallery_spill": true,
    "sam_match_iou": 0.3,
    "use_offline_tracklet_link": true,
    "tracklet_link_use_reid": true,
    "tracklet_link_max_gap_frames": 0,
    "tracklet_link_min_sim": 0.65,
    "tracklet_link_samples_per_tracklet": 8,
    "reid_backend": "solider",
    "track_buffer": 900,
    "use_seg": false,
    "gpu_full_batch": false,
    "preload_video": false,
    "frame_source_mode": "windowed",
    "infer_batch_size": 64,
    "gpu_queue_depth": 4,
    "decode_prefetch": 4,
    "realtime_mode": true,
    "frame_stride": 0,
    "smart_ram_budget": true,
    "max_process_ram_gb": 10.0,
    "use_tensorrt": true,
    "tensorrt_fp16": true,
    "tensorrt_autocast_fast": true,
    "tensorrt_max_batch": 32,
    "inference_device": "cuda",
    "encode_mode": "manual",
    "cross_check_enabled": true,
    "cross_check_object_prompt": "helmet",
    "cross_check_warning_text": "NO HELMET",
    "cross_check_conf": 0.35,
    "cross_check_min_intersection_px": 20.0,
    "cross_check_min_iou": 0.03,
    "cross_check_helmet_min_conf": 0.30,
    "cross_check_min_violation_streak": 2,
    "cross_check_verdict_history": 5,
    "cross_check_draw_head_box": true,
    "cross_check_draw_boxes": true,
    "detect_conf": 0.2,
    "seg_conf": 0.2,
    "match_iou_min": 0.45,
    "appearance_thresh": 0.55,
    "pose_kpt_conf": 0.25,
    "overlay_alpha": 0.45,
    "draw_boxes": true,
    "draw_masks": false,
    "draw_centers": false,
    "draw_pose": false,
    "default_prompt": "person"
  }
}

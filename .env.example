# Copy to .env or set in docker-compose.yml

YOLO_DRT_MODELS_DIR=/data/models
YOLO_DRT_OUTPUT_DIR=/data/output
YOLO_DRT_DETECT_MODEL=/data/models/YOLO/yolo26x-pose.pt
YOLO_DRT_CROSS_MODEL=/data/models/YOLO/Helmet/helmet-26m.pt
YOLO_DRT_REID_MODEL=/data/models/RD/osnet_ain_x1_0_msmt17_256x128_amsgrad_ep50_lr0.0015_coslr_b64_fb10_softmax_labsmth_flip_jitter.pth

# Identity (defaults = SAM F2F + offline Pass 2)
YOLO_DRT_USE_SAM_IDENTITY=true
YOLO_DRT_USE_REID=false
YOLO_DRT_SAM_IDENTITY_BACKEND=memory
# YOLO_DRT_SAM_MODEL=
YOLO_DRT_SAM_MATCH_IOU=0.30
YOLO_DRT_SAM_OSNET_REENTRY=false
YOLO_DRT_USE_OFFLINE_TRACKLET_LINK=true
YOLO_DRT_TRACKLET_LINK_USE_REID=true
YOLO_DRT_TRACKLET_LINK_MAX_GAP_FRAMES=300
YOLO_DRT_TRACKLET_LINK_MIN_SIM=0.60
YOLO_DRT_TRACKLET_LINK_SAMPLES_PER_TRACKLET=5
YOLO_DRT_TRACKLET_LINK_SPATIAL_WEIGHT=0.15

# Classic live OSNet fallback:
# YOLO_DRT_USE_SAM_IDENTITY=false
# YOLO_DRT_USE_REID=true
# YOLO_DRT_USE_OFFLINE_TRACKLET_LINK=false

YOLO_DRT_USE_SEG=false
YOLO_DRT_USE_TENSORRT=true
YOLO_DRT_CROSS_CHECK_ENABLED=true
YOLO_DRT_ENCODE_MODE=manual
YOLO_DRT_REALTIME_MODE=true
YOLO_DRT_GPU_FULL_BATCH=false
YOLO_DRT_INFER_BATCH_SIZE=64
YOLO_DRT_GPU_QUEUE_DEPTH=4
YOLO_DRT_DECODE_PREFETCH=4
YOLO_DRT_TRACK_BUFFER=300
YOLO_DRT_SMART_RAM_BUDGET=true
YOLO_DRT_MAX_PROCESS_RAM_GB=10.0
YOLO_DRT_MAX_WINDOW_RAM_GB=4.0
YOLO_DRT_MAX_PRELOAD_RAM_GB=12.0
YOLO_DRT_FRAME_SOURCE_MODE=auto
YOLO_DRT_INFERENCE_DEVICE=cuda

YOLO_DRT_TRT_ENGINE_STRATEGY=central
YOLO_DRT_TRT_REBUILD_POLICY=missing_only
YOLO_DRT_TRT_MANIFEST_DIR=/data/models/TRT
YOLO_DRT_TRT_IMGSZ=640
YOLO_DRT_TRT_MAX_BATCH=32
YOLO_DRT_TRT_FP16=true
YOLO_DRT_TRT_WORKSPACE_GB=2.0
YOLO_DRT_TRT_AUTOCAST_FAST=true
